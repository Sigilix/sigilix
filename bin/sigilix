#!/usr/bin/env bash
# SIG-304 — local `sigilix` launcher (Phase 1, no build step). Resolves the repo
# root from this script's location, auto-loads the BYO model keys from the
# gitignored .dev.vars if they aren't already in the environment, and runs the
# CLI entrypoint through the repo's local tsx. Phase 2 ships a real npm bin.
#
#   alias sigilix="$(git rev-parse --show-toplevel)/bin/sigilix"   # then: sigilix review --diff main --rich
set -euo pipefail

# Resolve through symlinks so `npm link` (which points a global bin symlink at this
# file) still finds the real repo root — not the global bin dir.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE:0:1}" != "/" ] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# Auto-load keys from .dev.vars (only if unset — an explicit env wins). Includes
# SIGILIX_API_KEY: once it's in .dev.vars, `sigilix review` runs HOSTED (our models)
# instead of falling back to the local engine — no flag, no export needed.
if [[ -f "$ROOT/.dev.vars" ]]; then
  for key in SIGILIX_API_KEY OPENROUTER_API_KEY OLLAMA_API_KEY GITHUB_TOKEN; do
    if [[ -z "${!key:-}" ]]; then
      val="$(grep -E "^${key}=" "$ROOT/.dev.vars" | head -n1 | cut -d= -f2- || true)"
      [[ -n "$val" ]] && export "$key=$val"
    fi
  done
fi

# Pin tsx to the sigilix tsconfig so the `@/` path alias (and every transitive
# engine import) resolves against the SIGILIX repo — not the user's cwd. Without
# this, running from any other repo (the whole point of --uncommitted / --diff)
# fails with "Cannot find package '@/src'".
exec env TSX_TSCONFIG_PATH="$ROOT/tsconfig.json" \
  "$ROOT/node_modules/.bin/tsx" --tsconfig "$ROOT/tsconfig.json" "$ROOT/src/cli/bin.ts" "$@"
