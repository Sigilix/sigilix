{
  // SIG-391: typecheck the test/e2e/eval/script tree. These run in Node (vitest,
  // tsx), so they get the Node type environment on top of the Workers types —
  // unlike production (tsconfig.json), which stays Workers-pure so a stray
  // `node:fs`/`process` in src/ is caught early. Same strict options as
  // production (inherited via extends); the only delta is the added node types
  // and the broadened include. CI runs both configs; the editor uses this one
  // for any file under these globs, so test files typecheck cleanly in-editor.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "evals/**/*.ts", "scripts/**/*.ts"]
}
