# sig-mcp-connections-p1: the `agents` package (Cloudflare Agents SDK, used for
# the Worker-as-MCP-client + built-in OAuth) declares `react` and `vite` as
# peer dependencies for its (unused-by-us) React-hooks/dev-tooling export
# paths — this Worker has no React anywhere. `npm ci` in CI runs the plain
# command (`.github/workflows/ci.yml`), so this flag has to live here rather
# than be passed ad hoc, or CI's `npm ci` 1:1-reproduces the ERESOLVE from a
# clean peer-dependency install. We only import `agents`'s MCP-client subpath
# (`agents/mcp/client`), which does not touch react/vite at runtime — the
# unmet peers are inert for our bundle.
legacy-peer-deps=true
