+import { describe, it, expect } from "vitest";
+import { decideWebhookResponse, HANDLED_ACTIONS } from "./webhooks";
+
+describe("decideWebhookResponse", () => {
+  it("queues (202) every handled pull_request action", () => {
+    for (const action of HANDLED_ACTIONS) {
+      expect(decideWebhookResponse(action)).toEqual({ status: 202, body: { queued: true } });
+    }
+  });
+
+  it("no-ops (200 ignored) on unhandled actions and empty input", () => {
+    for (const action of ["closed", "labeled", "assigned", ""]) {
+      expect(decideWebhookResponse(action)).toEqual({ status: 200, body: { ignored: true } });
+    }
+  });
+
+  it("handles exactly the documented action set", () => {
+    expect(HANDLED_ACTIONS).toEqual(["opened", "synchronize", "reopened", "ready_for_review"]);
+  });
+});
