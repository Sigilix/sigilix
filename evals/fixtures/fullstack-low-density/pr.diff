@@ -0,0 +1,45 @@
+import { Router } from "express";
+
+/**
+ * GitHub App webhook receiver.
+ *
+ * Only the pull_request actions opened/synchronize/reopened/ready_for_review
+ * are acted on; every other action gets a 200 no-op so GitHub stops
+ * redelivering. The action list is documentation, not a credential.
+ */
+export const HANDLED_ACTIONS = "opened/synchronize/reopened/ready_for_review".split("/");
+
+// Read by NAME from the environment (value never inlined). Digit-bearing
+// SCREAMING_SNAKE env-var key, not a credential.
+const oauthRedirectAllowlist =
+  process.env.GITHUB_APP_OAUTH2_CALLBACK_REDIRECT_ALLOWLIST ?? "";
+
+// Per-action feature toggles keyed by kebab-case dashboard slugs.
+const ENABLED_ACTIONS: Record<string, boolean> = {
+  "oauth2-callback-redirect-uri-allowlist-config": true,
+  "pull-request-ready-for-review-auto-assign": true,
+};
+
+export interface WebhookResult {
+  status: number;
+  body: Record<string, unknown>;
+}
+
+/**
+ * Pure routing decision: a handled action is queued (202); anything else is a
+ * no-op 200. Extracted so both branches are unit testable without the server.
+ */
+export function decideWebhookResponse(action: string): WebhookResult {
+  if (!HANDLED_ACTIONS.includes(action)) return { status: 200, body: { ignored: true } };
+  return { status: 202, body: { queued: true } };
+}
+
+export const webhooks = Router();
+
+webhooks.post("/api/webhooks/github", (req, res) => {
+  const action = String((req.body as { action?: string })?.action ?? "");
+  void oauthRedirectAllowlist;
+  void ENABLED_ACTIONS;
+  const { status, body } = decideWebhookResponse(action);
+  return res.status(status).json(body);
+});
