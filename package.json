{
  "name": "sigilix",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Sigilix — multi-agent AI code review for GitHub. Cloudflare Worker + OpenRouter specialists. The mark of merge-ready code.",
  "type": "module",
  "bin": {
    "sigilix": "bin/sigilix"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check:advisory-db-size": "./scripts/check-advisory-db-size.sh",
    "bakeoff-report": "tsx scripts/bakeoff-report.ts",
    "fp-rate-report": "tsx scripts/fp-rate-report.ts",
    "dispatch-monitor": "tsx scripts/dispatch-monitor.ts",
    "fp-eval": "tsx scripts/fp-eval.ts",
    "logic-recall-eval": "vitest run e2e/logic-recall-eval.live.test.ts",
    "security-overfire-eval": "vitest run e2e/security-overfire-eval.live.test.ts",
    "performance-overfire-eval": "vitest run e2e/performance-overfire-eval.live.test.ts",
    "tests-overfire-eval": "vitest run e2e/tests-overfire-eval.live.test.ts",
    "more-info-eval": "vitest run e2e/more-info-eval.live.test.ts",
    "synth-retention-eval": "vitest run e2e/synth-retention-eval.live.test.ts",
    "ci-triage-synth-eval": "vitest run e2e/ci-triage-synth-eval.live.test.ts",
    "anchor-exactness-eval": "vitest run e2e/anchor-exactness-eval.live.test.ts",
    "symbol-expansion-eval": "vitest run e2e/symbol-expansion-eval.live.test.ts",
    "reproduce-fp-eval": "vitest run e2e/reproduce-fp-eval.test.ts",
    "evals": "tsx evals/cli.ts",
    "retrieval-ab-report": "tsx scripts/retrieval-ab-report.ts",
    "phase4-calibrate": "tsx scripts/phase4-calibrate.ts",
    "collect-sig-161-findings": "tsx scripts/collect-sig-161-findings.ts",
    "thin-client:build": "tsx scripts/build-thin-client.ts",
    "regenerate-badge-paths": "tsx scripts/generate-badge-glyph-paths.ts",
    "fixture-eval": "vitest run e2e/fixture-eval.live.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.21",
    "@types/opentype.js": "^1.3.9",
    "@types/semver": "7.5.8",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "acorn": "8.14.0",
    "acorn-typescript": "1.4.13",
    "acorn-walk": "8.3.4",
    "fflate": "0.8.2",
    "js-yaml": "^4.2.0",
    "jsonrepair": "^3.14.0",
    "picomatch": "^4.0.4",
    "quickjs-emscripten": "^0.32.0",
    "semver": "7.6.3"
  }
}
