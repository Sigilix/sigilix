{
  "name": "sigilix",
  "version": "0.1.0",
  "private": true,
  "description": "Sigilix — multi-agent AI code review for GitHub. Cloudflare Worker + Ollama Turbo specialists. The mark of merge-ready code.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit && eslint . && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check:advisory-db-size": "./scripts/check-advisory-db-size.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/semver": "7.5.8",
    "eslint": "^9.39.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "acorn": "8.14.0",
    "acorn-typescript": "1.4.13",
    "acorn-walk": "8.3.4",
    "jsonrepair": "^3.14.0",
    "semver": "7.6.3"
  }
}
