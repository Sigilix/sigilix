{
  "name": "sigilix",
  "version": "0.1.0",
  "private": true,
  "description": "Sigilix — multi-agent AI code review for GitHub. Cloudflare Worker + Ollama Turbo specialists. The mark of merge-ready code.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit && eslint . && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check:advisory-db-size": "./scripts/check-advisory-db-size.sh",
    "bakeoff-report": "tsx scripts/bakeoff-report.ts",
    "phase4-calibrate": "tsx scripts/phase4-calibrate.ts",
    "collect-sig-161-findings": "tsx scripts/collect-sig-161-findings.ts",
    "regenerate-badge-paths": "tsx scripts/generate-badge-glyph-paths.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/opentype.js": "^1.3.9",
    "@types/semver": "7.5.8",
    "eslint": "^9.39.4",
    "opentype.js": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "acorn": "8.14.0",
    "acorn-typescript": "1.4.13",
    "acorn-walk": "8.3.4",
    "fflate": "0.8.2",
    "jsonrepair": "^3.14.0",
    "picomatch": "^4.0.4",
    "semver": "7.6.3"
  }
}
