{
  "display_information": {
    "name": "Sigilix",
    "description": "Sigilix — your code-aware teammate. Ask it about your codebase or open a triaged Linear issue, right from Slack.",
    "background_color": "#c81e2d"
  },
  "features": {
    "bot_user": {
      "display_name": "Sigilix",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://app.sigilix.ai/slack/oauth/callback"],
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "channels:history", "groups:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://app.sigilix.ai/slack/events",
      "bot_events": ["app_mention"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
